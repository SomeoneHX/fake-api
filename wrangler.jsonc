{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fake-openai-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "rules": [
    { "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }
  ],
  "routes": [
    { "pattern": "ai.sohx.asia", "custom_domain": true }
  ],
  "vars": {
    "API_KEY": "",
    "MODEL_ALIASES": "{}",
    "STREAM_PACING_MS": "0"
  },
  "observability": { "enabled": true }
}
