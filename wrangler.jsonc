{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fake-openai-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "rules": [
    { "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }
  ],
  "routes": [
    { "pattern": "ai.sohx.asia", "custom_domain": true }
  ],
  "assets": {
    "directory": "web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fake-openai-usage",
      "database_id": "1c0a3c27-f7a7-481c-a9c7-debece2d526b"
    }
  ],
  "vars": {
    "API_KEY": "",
    "MODEL_ALIASES": "{}",
    "STREAM_PACING_MS": "0"
  },
  "observability": { "enabled": true }
}
